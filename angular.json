"build": {
  "builder": "@angular/build:application",
  "options": {
    "outputPath": "dist/angular-graphql-task",
    "index": "src/index.html",
    "browser": "src/main.ts",
    "tsConfig": "tsconfig.app.json",
    "assets": [
      "src/assets"
    ],
    "styles": [
      "src/styles.css"
    ]
  },
  "configurations": {
    "production": {
      "optimization": true,
      "outputHashing": "all"
    }
  },
  "defaultConfiguration": "production"
}
